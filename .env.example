# --- Required: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional but recommended for server actions that need elevated privileges:
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Model provider API keys (enable specific features) ---
OPENAI_API_KEY=
STABILITY_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=

# A random secret for session cookies (SSR helpers)
NEXT_PRIVATE_COOKIE_SECRET=change_me_32_chars_min
